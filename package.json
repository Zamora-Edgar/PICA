{
  "name": "cartbot",
  "version": "1.0.0",
  "description": "AI-powered SMS/iMessage shopping assistant that finds the cheapest prices across stores",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "tunnel": "npx localtunnel --port 3000"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@photon-ai/api": "^0.5.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "spectrum-ts": "^0.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
