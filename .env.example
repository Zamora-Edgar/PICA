# CartBot Environment Variables
# Copy this file to .env and fill in your keys

# ─── Photon 2.0 (messaging: iMessage/SMS/WhatsApp) ───────────────────────────
# Get from: https://photon.codes (sign up for hackathon access)
PHOTON_PROJECT_ID=your_photon_project_id_here
PHOTON_PROJECT_SECRET=your_photon_project_secret_here

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey (free, instant)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── SerpAPI (Google Shopping price data) ────────────────────────────────────
# Get from: https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# ─── Server Config ────────────────────────────────────────────────────────────
PORT=3000

# ─── Optional: Ngrok / LocalTunnel public URL (for Photon webhook) ────────────
# Set this after running your tunnel so Photon knows where to send messages
PUBLIC_URL=https://your-tunnel-url.loca.lt
