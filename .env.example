DATABASE_URL="file:./dev.db"
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"

# Photon 2.0 — communication layer. PHOTON_MOCK=true logs outbound messages instead of sending.
PHOTON_MOCK=true
PHOTON_API_BASE="https://api.photon.example/v2"
PHOTON_API_KEY=""
PHOTON_WEBHOOK_SECRET=""
PHOTON_VOICE_NUMBER=""

# Visa Intelligent Commerce — trust & payment layer. VISA_MOCK=true simulates approvals.
VISA_MOCK=true
VISA_API_BASE="https://sandbox.api.visa.com"
VISA_USER_ID=""
VISA_PASSWORD=""

# LLM — any OpenAI-compatible endpoint.
# For Gemini: LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/" and a Gemini model name.
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o"
LLM_BASE_URL=""

APPROVAL_TTL_MINUTES=30
